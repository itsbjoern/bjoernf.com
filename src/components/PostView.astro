---
import { Image } from "astro:assets";
import Tag from "./Tag.astro";
import { formatDate } from "@/utils/formatDate";

import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import "@/content.css";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, createdAt, tags, image, summary } = post.data;
---

<div class="flex flex-col gap-5">
  <div class="flex flex-row items-center gap-5 smo:flex-col">
    {
      image ? (
        <div class="image-container">
          <Image width={250} height={250} src={image} alt="" quality={90} />
        </div>
      ) : null
    }
    <div class="flex flex-1 flex-col justify-center gap-2 smo:self-stretch">
      <div class="flex flex-row flex-wrap justify-between items-center gap-2">
        {
          tags && tags.length ? (
            <div class="flex flex-row gap-2">
              {tags.map((t) => (
                <Tag name={t} variant="outlined" />
              ))}
            </div>
          ) : null
        }
        <span class="text-muted" style={{ fontSize: "0.75rem" }}>
          Published {formatDate(createdAt ?? new Date())}
        </span>
      </div>
      <h1 class="text-2xl font-bold">{title}</h1>
    </div>
  </div>
  <div class="post-content">
    <Content />
  </div>
</div>

<style>
  .image-container {
    width: 120px;
    min-width: 120px;
    height: 120px;

    position: relative;
    display: flex;

    overflow: hidden;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--color-line);
    background: white;

    align-items: center;
    justify-content: center;
  }
  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
