---
interface Props {
  external: boolean;
  href: string;
  rel?: string;
}

const { href, external, rel = "noreferrer noopener" } = Astro.props;
---

{
  external ? (
    <a class="link inline" href={href} rel={rel} target="_blank">
      <slot />
    </a>
  ) : (
    <a class="link" href={href}>
      <slot />
    </a>
  )
}
